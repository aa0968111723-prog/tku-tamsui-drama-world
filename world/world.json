  "episode": {
    "id": "ep01",
    "title": "第一集：宮燈下的迎新",
    "logline": "新生安倢踏入淡江，卻發現柏能學長在驚聲廣場失聯——一場橫跨校園與淡水的尋人劇本就此展開。",
    "scenes": [
      {
        "id": "s1",
        "title": "宮燈大道 · 開場",
        "locationId": "palace",
        "characters": [
          "anjie",
          "xiaoyu"
        ],
        "beats": [
          {
            "type": "action",
            "text": "黃昏。宮燈亮起。安倢拖著行李站在迎新點。"
          },
          {
            "type": "dialogue",
            "speaker": "xiaoyu",
            "text": "安倢同學？歡迎來到淡江大學淡水校園！"
          },
          {
            "type": "dialogue",
            "speaker": "anjie",
            "text": "學姊好……這邊風景好像電影片場。"
          },
          {
            "type": "dialogue",
            "speaker": "xiaoyu",
            "text": "今天你有任務：找到在驚聲大樓前失聯的柏能學長。路上記得蓋新生戳章。"
          }
        ]
      },
      {
        "id": "s2",
        "title": "美食廣場 · 支線",
        "locationId": "foodcourt",
        "characters": [
          "anjie",
          "azhen"
        ],
        "beats": [
          {
            "type": "action",
            "text": "學餐飄出便當香味，角落卻有「迷航史萊姆」亂竄（想像中的迎新惡作劇）。"
          },
          {
            "type": "dialogue",
            "speaker": "azhen",
            "text": "欸新生！幫阿姨清掉那些綠色的，請你喝提神飲料。"
          },
          {
            "type": "dialogue",
            "speaker": "anjie",
            "text": "好！清完我就往東邊圖書館方向走。"
          }
        ]
      },
      {
        "id": "s3",
        "title": "圖書館 · 情報",
        "locationId": "library",
        "characters": [
          "anjie"
        ],
        "beats": [
          {
            "type": "action",
            "text": "玻璃中庭灑進午後光。安倢在公告欄看到驚聲廣場「迎新挑戰」海報。"
          },
          {
            "type": "dialogue",
            "speaker": "anjie",
            "text": "張哲維學長的挑戰……柏能一定被卡在那。"
          },
          {
            "type": "note",
            "text": "可安插：同學NPC給路線提示（體育館→驚聲）。"
          }
        ]
      },
      {
        "id": "s4",
        "title": "驚聲廣場 · 高潮",
        "locationId": "chingsheng",
        "characters": [
          "anjie",
          "zhewei",
          "bainen"
        ],
        "beats": [
          {
            "type": "action",
            "text": "廣場風大。張哲維站在中央，柏能被「挑戰規則」困在一旁。"
          },
          {
            "type": "dialogue",
            "speaker": "zhewei",
            "text": "想救學長？先證明你配得上淡江的山與坡。"
          },
          {
            "type": "dialogue",
            "speaker": "anjie",
            "text": "我不是來證明的——我是來把人帶回去。"
          },
          {
            "type": "action",
            "text": "挑戰戰（可接遊戲關卡）。安倢獲勝。"
          },
          {
            "type": "dialogue",
            "speaker": "bainen",
            "text": "你來了……我們回宮燈大道吧。"
          }
        ]
      },
      {
        "id": "s5",
        "title": "淡水河岸 · 收束",
        "locationId": "riverside",
        "characters": [
          "anjie",
          "bainen"
        ],
        "beats": [
          {
            "type": "action",
            "text": "兩人走出校園，河面映著觀音山剪影。"
          },
          {
            "type": "dialogue",
            "speaker": "bainen",
            "text": "淡水不只是上課的地方。你慢慢會懂。"
          },
          {
            "type": "dialogue",
            "speaker": "anjie",
            "text": "那下一集，我們從老街開始？"
          },
          {
            "type": "note",
            "text": "卡黑。預告第二集：老街傳聞。"
          }
        ]
      }
    ]
  }
